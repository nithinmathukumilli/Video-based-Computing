# Copy this file to ".env" (same folder) and fill in your values. The app reads it when it starts.
# ".env" holds secrets: never send it to anyone, and leave it out of any zip you deploy or share.
# Azure app settings (in production) override anything written here.

# Personal Teams messages: the address of your Power Automate flow ("Alert me when seats open")
TEAMS_PERSONAL_WEBHOOK_URL=

# Teams channel alerts: the address of your channel Workflows webhook
TEAMS_WEBHOOK_URL=

# The address people open the app at (shown as the button on Teams cards)
PUBLIC_URL=http://localhost:3000

# Who can edit tables (comma-separated emails). Leave empty in local testing.
ADMINS=

# Local testing only: signs everyone in as this user. NEVER set this in production.
DEV_USER=

# Camera feed (live-feed POC): a script posts seat counts to /api/camera with this key in the X-Camera-Key header. Empty = off.
CAMERA_KEY=

# Camera: how many minutes a tap on 'Sit here' counts at a camera-watched table before the camera decides (default 10)
CAMERA_TAP_GRACE_MINUTES=10

# Optional (uncomment to use)
# Camera: minutes without news before "from camera" is dropped (default 10)
# CAMERA_FRESH_MINUTES=10
# Port to listen on (default 3000)
# PORT=3000
# Minutes a hold lasts before the seats are released (default 5)
# HOLD_MINUTES=5
# Channel alerts: seats freed before a post (default 2) and the shortest time between posts in seconds (default 300)
# TEAMS_ALERT_MIN_SEATS=2
# TEAMS_ALERT_COOLDOWN_SECONDS=300
# Demo sign-in: any person types a work email on the page. NOT for production. Remove to use DEV_USER / Azure sign-in.
# DEMO_LOGIN=1
# DEMO_EMAIL_DOMAIN=company.com
